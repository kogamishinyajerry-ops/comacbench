    "code": "\"import cadquery as cq\\n\\n# Define the 12 vertices of the regular polygon in local (u, v) coordinates\\nvertices = [\\n    (17.840885, -5.320644),\\n    (22.182779, 1.116478),\\n    (22.724408, 8.862135),\\n    (19.320644, 15.840885),\\n    (12.883522, 20.182779),\\n    (5.137865, 20.724408),\\n    (-1.840885, 17.320644),\\n    (-6.182779, 10.883522),\\n    (-6.724408, 3.137865),\\n    (-3.320644, -3.840885),\\n    (3.116478, -8.182779),\\n    (10.862135, -8.724408),\\n]\\n\\n# Use the YZ plane: local u -> global +Y, local v -> global +Z\\nP = cq.Plane.named(\\\"YZ\\\")\\n\\n# Build the 12 line edges forming a closed loop\\nedges = []\\nn = len(vertices)\\nfor i in range(n):\\n    p1 = P.toWorldCoords(vertices[i])\\n    p2 = P.toWorldCoords(vertices[(i + 1) % n])\\n    edges.append(cq.Edge.makeLine(p1, p2))\\n\\n# Export as STEP file\\ncq.exporters.export(cq.Compound.makeCompound(edges), \\\"sketch.step\\\")\"",
