FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.water 0
);

regions
(
    // Water column at the left bottom corner: base width a = 0.146 m,
    // height 2a = 0.292 m (Martin & Moyce n^2 = 2 configuration).
    boxToCell
    {
        box (0 0 -1) (0.146 0.292 1);
        fieldValues
        (
            volScalarFieldValue alpha.water 1
        );
    }
);

