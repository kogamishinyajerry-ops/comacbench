FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Sod (1978) left state: p = 1 Pa for x < 0.5; setFields overwrites the
// right half with p = 0.1 Pa (see system/setFieldsDict).
dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    sides
    {
        type            zeroGradient;
    }

    empty
    {
        type            empty;
    }
}


