FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Inner cylinder rotates about z at omega = 1 rad/s (u_theta(R_i) = 0.05 m/s),
// outer cylinder stationary. Fluid starts from rest.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    innerCylinder
    {
        type            rotatingWallVelocity;
        origin          (0 0 0);
        axis            (0 0 1);
        omega           1.0;
    }
    outerCylinder
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty;
    }
}

