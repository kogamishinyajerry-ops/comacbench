FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    innerCylinder
    {
        type            zeroGradient;
    }
    outerCylinder
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

