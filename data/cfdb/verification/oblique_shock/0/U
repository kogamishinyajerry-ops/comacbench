FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Normalised units (see constant/thermophysicalProperties): a1 ~ 1, so
// U1 = 2 gives M1 ~ 2. Field initialised to freestream everywhere.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (2 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (2 0 0);
    }

    outlet
    {
        // supersonic outflow: no downstream information enters
        type            zeroGradient;
    }

    bottom
    {
        type            symmetryPlane;
    }

    top
    {
        type            symmetryPlane;
    }

    wedge
    {
        // inviscid wall
        type            slip;
    }

    frontAndBack
    {
        type            empty;
    }
}


